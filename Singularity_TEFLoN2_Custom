Bootstrap: docker
From: ubuntu:22.04

%help
    Container for TEFLoN2
    https://github.com/asfistonlavie/TEFLoN2

    Includes:
        - BWA 0.7.17
        - RepeatMasker 4.1.6
        - Python 3.8+
        - Samtools 1.16.1
        - Snakemake 7.14.0

%labels
    VERSION "TEFLoN2 v1.0"
    Maintainer "Corentin Marco"
    Maintainer2 "Anna-Sophie Fiston-Lavier"
    Date "October 2023"

%post
    export DEBIAN_FRONTEND=noninteractive
    export LC_ALL=C

    apt-get update && apt-get install -y apt-utils
    apt-get install -y \
        tzdata \
        autoconf \
        automake \
        bwa \
        cmake \
        gcc \
        build-essential \
        tar \
        unzip \
        wget \
        zlib1g-dev \
        sudo \
        locales \
        python3 \
        python3-pip \
        ncbi-blast+ \
        bedtools \
        minimap2 \
        perl \
        pandoc-citeproc \
        python3-h5py \
        libfontconfig1-dev \
        libxml2-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libbz2-dev \
        liblzma-dev \
        curl \
        gawk \
        libncurses5-dev \
        pigz \
        tcl \
        gzip \
        libncbi-vdb-dev \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # Upgrade pip
    pip3 install --upgrade pip

    # Install datrie
    pip3 install Cython
    pip3 install --no-build-isolation datrie

    # Install Snakemake and dependencies
    pip3 install \
        snakemake==7.14.0 \
        pulp==2.3.1 \
        h5py \
        six

    # Install fastp
    wget http://opengene.org/fastp/fastp -O /usr/local/bin/fastp
    chmod +x /usr/local/bin/fastp

    # Install Samtools 1.16.1
    cd /tmp
    wget https://github.com/samtools/samtools/releases/download/1.16.1/samtools-1.16.1.tar.bz2
    tar -xjf samtools-1.16.1.tar.bz2
    cd samtools-1.16.1
    ./configure --prefix=/usr/local
    make -j$(nproc)
    make install
    cd / && rm -rf /tmp/samtools-1.16.1*

    # Install TRF (Tandem Repeat Finder)
    cd /usr/local/bin/
    wget https://github.com/Benson-Genomics-Lab/TRF/releases/download/v4.09.1/trf409.linux64 -O trf
    chmod +x trf

    # Install HMMER
    cd /tmp
    wget http://eddylab.org/software/hmmer/hmmer-3.2.1.tar.gz
    tar -xzf hmmer-3.2.1.tar.gz
    cd hmmer-3.2.1
    ./configure
    make -j$(nproc)
    make install
    cd / && rm -rf /tmp/hmmer-3.2.1*

    # Install RepeatMasker 4.1.6
    cd /usr/local
    wget https://www.repeatmasker.org/RepeatMasker/RepeatMasker-4.1.6.tar.gz
    tar -xzf RepeatMasker-4.1.6.tar.gz
    rm RepeatMasker-4.1.6.tar.gz

    # Configure RepeatMasker
    cd /usr/local/RepeatMasker
    perl ./configure \
        --trf_prgm=/usr/local/bin/trf \
        --hmmer_dir=/usr/local/bin \
        --default_search_engine=rmblast

%environment
    export LC_ALL=C
    export PATH=/usr/local/bin:/usr/local/RepeatMasker:$PATH

%runscript
    exec RepeatMasker "$@"
